# Copy to .env and change the passwords: cp .env.example .env
# Later phases add more settings; docs/SPEC.md section 11 has the full list.

# --- Application ---
APP_ENV=development
# Must stay 0.0.0.0 in Docker, or the published port cannot reach the API.
APP_HOST=0.0.0.0
APP_PORT=8080
# How long in-flight requests get to finish on shutdown.
APP_SHUTDOWN_TIMEOUT=10s

# --- Host side of the port mapping ---
# The default keeps the API private to this machine.
API_PUBLISH_HOST=127.0.0.1
API_PUBLISH_PORT=8080

# --- Database selection ---
# Keep both in sync. Leave COMPOSE_PROFILES empty to use an external database.
DB_DRIVER=postgres
COMPOSE_PROFILES=postgres

# --- Connection pool, for the selected driver ---
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
# How long startup waits for the database before giving up.
DB_CONNECT_TIMEOUT=60s

# --- PostgreSQL, required only when DB_DRIVER=postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=site_checker
POSTGRES_USERNAME=site_checker
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable
