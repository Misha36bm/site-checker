# Copy to .env and change the passwords: cp .env.example .env
# Later phases add more settings; docs/SPEC.md section 11 has the full list.

# --- Application ---
APP_ENV=development
# Must stay 0.0.0.0 in Docker, or the published port cannot reach the API.
APP_HOST=0.0.0.0
APP_PORT=8080
# How long in-flight requests get to finish on shutdown.
APP_SHUTDOWN_TIMEOUT=10s

# --- Host side of the port mapping ---
# The default keeps the API private to this machine.
API_PUBLISH_HOST=127.0.0.1
API_PUBLISH_PORT=8080

# --- Request limits ---
API_MAX_BODY_BYTES=4096
API_MAX_URL_LENGTH=2048

# --- Background processing ---
MAX_CONCURRENT_CHECKS=5
# New checks get 503 once this many are waiting.
MAX_PENDING_CHECKS=1000
WORKER_POLL_INTERVAL=1s
# A check whose worker stops renewing this claim goes back to the queue.
CHECK_LOCK_TTL=2m
# Claims before an interrupted check fails with worker_abandoned.
CHECK_MAX_ATTEMPTS=3
# Keep below stop_grace_period in docker-compose.yml.
WORKER_SHUTDOWN_TIMEOUT=30s

# --- HTTP checker ---
# Covers the whole redirect chain, not each request.
HTTP_TIMEOUT=15s
# Redirects to follow. 0 follows none.
HTTP_MAX_REDIRECTS=10
HTTP_MAX_BODY_BYTES=5242880
HTTP_USER_AGENT=site-checker/1.0

# --- SSRF protection ---
# Comma-separated CIDR ranges exempt from blocking, for monitoring internal sites.
# Example: 10.20.0.0/16,192.168.1.0/24. Cloud metadata addresses stay blocked.
SSRF_ALLOWED_CIDRS=

# --- Database selection ---
# Keep both in sync. Leave COMPOSE_PROFILES empty to use an external database.
DB_DRIVER=postgres
COMPOSE_PROFILES=postgres

# --- Connection pool, for the selected driver ---
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
# How long startup waits for the database before giving up.
DB_CONNECT_TIMEOUT=60s

# --- PostgreSQL, required only when DB_DRIVER=postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=site_checker
POSTGRES_USERNAME=site_checker
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable
